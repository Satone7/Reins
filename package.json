{
  "name": "reins",
  "version": "0.1.0",
  "description": "Take the reins of all your local and remote AI coding harnesses — H2H MCP Server, Remote Session Hub, and Mobile Control Plane.",
  "type": "module",
  "main": "./src/index.js",
  "bin": {
    "reins": "./src/index.js",
    "reins-mcp": "./src/mcp/index.js"
  },
  "scripts": {
    "start": "node ./src/index.js",
    "mcp": "node ./src/mcp/index.js",
    "test": "node --test tests/reins-mvp.test.js",
    "test:e2e": "node --test tests/docker-e2e.test.js",
    "test:docker": "docker compose -f docker-compose.test.yml run --rm --build reins-test"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "mcp",
    "h2h",
    "harness",
    "agent-orchestration",
    "claude-code",
    "codex",
    "dsh",
    "antigravity",
    "remote-agent"
  ],
  "license": "MIT"
}
