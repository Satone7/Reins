# ============================================================================
# Reins Development & Test Environment Configuration
# ============================================================================
# Before running live LLM or Docker integration tests, copy this file to `.env`
# and fill in your DeepSeek API key:
#
#   cp .env.example .env
#
# `.env` is gitignored and will never be committed to the repository.
# ============================================================================

# Required: DeepSeek API key used by the unified test LLM (`deepseek-flash`)
DEEPSEEK_API_KEY=

# Optional: DeepSeek API base URL (defaults to official DeepSeek endpoint)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Unified LLM model identifier for all test targets
REINS_TEST_MODEL=deepseek-flash
